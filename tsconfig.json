{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "outDir": "dist",
    "paths": {
      "hardhat": ["./node_modules/hardhat"],
      "hardhat/config": ["./node_modules/hardhat/config"]
    }
  },
  "include": ["test/**/*.ts", "hardhat.config.ts", "ignition/**/*.ts"],
  "files": ["hardhat.config.ts"]
}
